# Site estático do Rapidão na Hostinger.
RewriteEngine On

# Sempre HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Arquivos internos do build não ficam à vista
RewriteRule ^__spa-fallback\.html$ - [F,L]

# Qualquer caminho que não seja arquivo volta para a página inicial
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ /index.html [L]

Options -Indexes
